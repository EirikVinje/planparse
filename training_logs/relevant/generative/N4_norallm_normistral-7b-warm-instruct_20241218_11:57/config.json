{
    "config_name": "norwai_mistral_7b",
    "template_path": "./prompt_templates/classification/mistral_v1.jinja",
    "train_path": "./formated_data/huge/splits/train.jsonl",
    "eval_path": "./formated_data/huge/splits/eval.jsonl",
    "test_path": "./formated_data/huge/splits/test.jsonl",
    "model_config": {
        "huggingface_model": "norallm/normistral-7b-warm-instruct",
        "torch_dtype": "float32",
        "load_in_4bit": false,
        "load_in_8bit": true,
        "access_token": null,
        "lora_dropout": 0.1,
        "lora_alpha": 16,
        "device": "cuda",
        "r": 8
    },
    "trainer_config": {
        "run_name": "norallm_normistral-7b-warm-instruct",
        "logging_dir": "./logging",
        "per_device_train_batch_size": 4,
        "per_device_eval_batch_size": 4,
        "gradient_accumulation_steps": 4,
        "num_train_epochs": 4,
        "torch_empty_cache_steps": true,
        "lr_scheduler_type": "linear",
        "save_dir": "./local_models/",
        "eval_strategy": "steps",
        "learning_rate": 0.0001,
        "output_dir": "./temp",
        "optim": "adamw_torch",
        "save_strategy": "no",
        "weight_decay": 0.001,
        "warmup_steps": 200,
        "report_to": "none",
        "logging_steps": 1,
        "eval_steps": 20,
        "max_steps": -1,
        "data_seed": 42,
        "seed": 42
    },
    "label2id": {
        "none": 0,
        "%-BYA": 1,
        "BYA": 2,
        "BRA": 3,
        "%-BRA": 4
    }
}