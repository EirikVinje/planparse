{
    "config_name": "norbert3-large",
    "train_path": "./formated_data/huge/splits/train.jsonl",
    "eval_path": "./formated_data/huge/splits/eval.jsonl",
    "test_path": "./formated_data/huge/splits/test.jsonl",
    
    "model_config": {
        "huggingface_model": "ltg/norbert3-large",
        "trust_remote_code": true,
        "device": "cuda",
        "label2id": {
            "none" : 0,
            "%-BYA" : 1,
            "BYA" : 2,
            "BRA" : 3,
            "%-BRA" : 4
        }
    },

    "trainer_config": {
        "run_name": "ltg_norbert3-large",
        "logging_dir" : "./training_logs",
        "per_device_train_batch_size": 4,
        "gradient_accumulation_steps": 4,
        "torch_empty_cache_steps": true,
        "per_device_eval_batch_size": 4,
        "save_dir": "./local_models/",
        "lr_scheduler_type": "linear",
        "eval_strategy": "steps",
        "eval_steps": 20,
        "learning_rate": 0.0001,
        "output_dir": "./temp",
        "optim": "adamw_torch",
        "num_train_epochs": 4,
        "save_strategy": "no",
        "weight_decay": 0.001,
        "warmup_steps": 200,
        "report_to": "none",
        "logging_steps": 1,
        "max_steps": -1,
        "data_seed": 42,
        "seed": 42
    }
}
